rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // === Users ===
    // Users can read any profile (needed for friend discovery) and write only their own.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // === Friends ===
    // Friend documents: members array contains both UIDs. Only members can read/write.
    match /friends/{friendId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
      allow update: if false;
    }

    // === Friend Requests ===
    match /friendRequests/{requestId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      // Only the sender can create a pending request.
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == "pending";
      // The recipient can accept/reject; the sender can cancel.
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.toUid
            || request.auth.uid == resource.data.fromUid);
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.toUid
            || request.auth.uid == resource.data.fromUid);
    }

    // === Playback Status (heartbeat) ===
    // One document per user describing what they're playing right now, consumed by the
    // partner's home-screen widget. Contains only now-playing metadata, so reads are open.
    match /status/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // === Sent Songs ===
    // A song sent between friends. Readable by sender and recipient only.
    // Validates required fields and prevents tampering with sender/recipient.
    match /sentSongs/{songId} {
      function isInvolved() {
        return request.auth != null
          && (request.auth.uid == resource.data.fromUid
              || request.auth.uid == resource.data.toUid);
      }

      // Involved parties (sender & recipient) can read their sent songs.
      allow read: if isInvolved();

      // Only the sender can create a sent song, with required fields present.
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.songId is string
        && request.resource.data.songTitle is string
        && request.resource.data.fromUid is string
        && request.resource.data.toUid is string
        && request.resource.data.sentAt is number;

      // Both parties can update progress fields (listenedAt/completedAt/notificationSent),
      // but sender and recipient cannot be changed after creation.
      allow update: if isInvolved()
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.songId == resource.data.songId;

      allow delete: if false;
    }
  }
}

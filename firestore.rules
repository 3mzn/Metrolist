rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // === Users ===
    // Users can read any profile (needed for friend discovery) and write only their own.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // === Friends ===
    // Friend documents: members array contains both UIDs. Only members can read/write.
    match /friends/{friendId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
      allow update: if false;
    }

    // === Friend Requests ===
    match /friendRequests/{requestId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      // Only the sender can create a pending request.
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == "pending";
      // The recipient can accept/reject; the sender can cancel.
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.toUid
            || request.auth.uid == resource.data.fromUid);
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.toUid
            || request.auth.uid == resource.data.fromUid);
    }

    // === Playback Status (heartbeat) ===
    // One document per user describing what they're playing right now, consumed by the
    // partner's home-screen widget. Contains only now-playing metadata, so reads are open.
    match /status/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // === Sent Songs ===
    // A song sent between friends. Readable by sender and recipient only.
    // Validates required fields and prevents tampering with sender/recipient.
    match /sentSongs/{songId} {
      function isInvolved() {
        return request.auth != null
          && (request.auth.uid == resource.data.fromUid
              || request.auth.uid == resource.data.toUid);
      }

      // Involved parties (sender & recipient) can read their sent songs.
      allow read: if isInvolved();

      // Only the sender can create a sent song, with required fields present.
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.songId is string
        && request.resource.data.songTitle is string
        && request.resource.data.fromUid is string
        && request.resource.data.toUid is string
        && request.resource.data.sentAt is number;

      // Both parties can update progress fields (listenedAt/completedAt/notificationSent),
      // but sender and recipient cannot be changed after creation.
      allow update: if isInvolved()
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.songId == resource.data.songId;

      // Recipient may prune their own completed copies (housekeeping keeps reads bounded).
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.toUid;
    }

    // === Listen Together Invites ===
    // One document per recipient (invites/{recipientUid}); a newer invite overwrites an
    // older one. Expiry is judged client-side from createdAt — no server TTL.
    match /invites/{recipientUid} {
      function isInviteParty() {
        return request.auth != null
          && (request.auth.uid == recipientUid
              || request.auth.uid == resource.data.fromUid);
      }

      // Sender watches for accepted/declined; recipient watches for incoming.
      allow read: if isInviteParty();

      // Only the sender creates, addressed to the recipient, starting as pending.
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.auth.uid != recipientUid
        && request.resource.data.roomCode is string
        && request.resource.data.fromName is string
        && request.resource.data.createdAt is number
        && request.resource.data.status == "pending";

      // Recipient flips status (sender/room binding immutable for them); sender may
      // overwrite their own pending invite wholesale (re-invite with a new room code).
      allow update: if request.auth != null && (
        (
          request.auth.uid == recipientUid
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.roomCode == resource.data.roomCode
        )
        || (
          request.auth.uid == resource.data.fromUid
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.status == "pending"
        )
      );

      // Recipient cleanup after accept/decline; sender cancel.
      allow delete: if isInviteParty();
    }

    // === Shared Playlists (SPEC_8 "Us" playlists) ===
    // One doc per shared playlist; doc id = local Room playlist id. Exactly two members:
    // sharedByUid (creator) and sharedWith (recipient). Both can read/write; last-writer-wins.
    match /sharedPlaylists/{playlistId} {
      function isMember() {
        return request.auth != null
          && (request.auth.uid == resource.data.sharedByUid
              || request.auth.uid == resource.data.sharedWith);
      }

      allow read: if isMember();

      // Creator writes the initial doc, naming themselves as sharedByUid and the partner
      // as sharedWith. Both fields must be present and distinct.
      allow create: if request.auth != null
        && request.resource.data.sharedByUid == request.auth.uid
        && request.resource.data.sharedWith is string
        && request.resource.data.sharedWith != request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.songs is list
        && request.resource.data.createdAt is number;

      // Either member can update any field (add/remove songs, rename, set cover).
      // sharedByUid is immutable after create.
      allow update: if isMember()
        && request.resource.data.sharedByUid == resource.data.sharedByUid;

      // Either member can delete (D28 symmetric delete).
      allow delete: if isMember();
    }

    // === Partner Deletion Tombstones (D8) ===
    // Written by a user during account deletion so the surviving partner promotes their
    // local shared playlists to local-only instead of removing them. Only the account
    // owner writes their own tombstone; the partner reads it.
    match /partners_deleted/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // === LT Chat messages (SPEC_LT_CHAT) ===
    // One doc per message. Membership is proven per document via the denormalized
    // `member_uids` array (sorted pair of the couple's UIDs) — same trick as
    // /friends.members. Messages are IMMUTABLE after create (no edit, no unsend);
    // only the retention prune deletes.
    match /lt_chat_messages/{messageId} {
      function isChatMember() {
        return request.auth != null
          && request.auth.uid in resource.data.member_uids;
      }

      allow read: if isChatMember();

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.member_uids
        && request.resource.data.sender_uid == request.auth.uid
        && request.resource.data.couple_id is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() < 4000
        && request.resource.data.type in ['text', 'emoji', 'system']
        && request.resource.data.member_uids.size() == 2
        && (request.resource.data.couple_id == request.resource.data.member_uids[0] + "_" + request.resource.data.member_uids[1]
            || request.resource.data.couple_id == request.resource.data.member_uids[1] + "_" + request.resource.data.member_uids[0]);

      allow update: if false;

      // Retention prune (client-side, 30-day default) and full history wipe by members.
      // NOTE: delete allowed for auto-delete prune; 2-user trust assumed.
      allow delete: if isChatMember();
    }

    // === LT Chat presence (SPEC_LT_CHAT) ===
    // Deterministic doc id `{coupleId}_{userUid}` — one per user per couple, upserted with
    // merge (typing flag, last_seen, last_read_at). Only the owner writes their own doc;
    // both members read (the partner's last_read_at drives read receipts).
    match /lt_chat_presence/{docId} {
      function isPresenceMember() {
        return request.auth != null
          && request.auth.uid in resource.data.member_uids;
      }

      allow read: if request.auth != null && (resource == null || isPresenceMember());

      allow create: if request.auth != null
        && request.resource.data.user_uid == request.auth.uid
        && request.auth.uid in request.resource.data.member_uids
        && request.resource.data.member_uids.size() == 2
        && request.resource.data.couple_id is string
        && (request.resource.data.couple_id == request.resource.data.member_uids[0] + "_" + request.resource.data.member_uids[1]
            || request.resource.data.couple_id == request.resource.data.member_uids[1] + "_" + request.resource.data.member_uids[0]);

      allow update: if request.auth != null
        && request.auth.uid == resource.data.user_uid
        && request.resource.data.user_uid == resource.data.user_uid
        && request.resource.data.couple_id == resource.data.couple_id
        && request.resource.data.member_uids == resource.data.member_uids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_typing', 'last_seen', 'last_read_at'])
        && (!('last_read_at' in resource.data) || !('last_read_at' in request.resource.data) || request.resource.data.last_read_at >= resource.data.last_read_at);

      allow delete: if false;
    }
  }
}
